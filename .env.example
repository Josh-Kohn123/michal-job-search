# Telegram bot credentials (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAaaBBccDDeeFFggHHiiJJkkLLmmNNooPP
# Target chat: your user id, a group id (negative, e.g. -1001234567890), or @channelusername
TELEGRAM_CHAT_ID=123456789

# ---- Optional filters (leave blank = send everything) ----
# Comma-separated, case-insensitive substring match against title + company + description
KEYWORDS=
EXCLUDE_KEYWORDS=
# Comma-separated term names/slugs, matched against the job's taxonomy terms
REGIONS=
CATEGORIES=
JOB_TYPES=
# true = only remote-flagged positions
REMOTE_ONLY=false

# ---- Optional behaviour ----
# Max Telegram messages per run (overflow is summarised in one message)
MAX_MESSAGES_PER_RUN=20
# true = record current jobs as "seen" without notifying (used for the first run)
SEED_ONLY=false
# true = print what would be sent, send nothing, write no state
DRY_RUN=false
